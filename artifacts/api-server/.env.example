# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins. Set to your Vercel frontend URL.
ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Supabase (required for candle persistence) ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ── Price feeds ────────────────────────────────────────────────────────────────
# Twelve Data — free tier gives 800 credits/day. Get key at twelvedata.com
TWELVE_DATA_API_KEY=your_twelve_data_key

# Alpha Vantage — free tier gives 25 requests/day. Get key at alphavantage.co
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ── Quotex signal layer (optional) ────────────────────────────────────────────
# Omit to run in Deriv-only mode (live prices without Quotex direction signals)
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_SESSION=

# ── Database (optional, for trade history) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
